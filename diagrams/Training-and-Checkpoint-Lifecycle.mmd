flowchart LR
    START["Start experiment"]
    CFG["Load matching model config<br/>and healthcare tokenizer"]
    PT["Healthcare pretraining<br/>random initialization"]
    PTCK[("Stage 1 last.pt<br/>weights + optimizer + step")]
    FIRST["First medical SFT run"]
    PTW["Load Stage 1 model weights only"]
    FRESH["Create fresh SFT AdamW optimizer"]
    SFT["Full-parameter medical SFT"]
    SFTCK[("Stage 2 last.pt<br/>weights + optimizer + step")]
    RES["Resume medical SFT"]
    REST["Restore SFT weights,<br/>optimizer and saved step"]
    MIR["Full-parameter MIRIAD SFT<br/>Stage 2 weights, fresh optimizer"]
    MIRCK[("Stage 3 checkpoint<br/>lowest validation loss")]
    TEST["Validation CE / perplexity<br/>and independent medical review"]

    START --> CFG --> PT --> PTCK --> FIRST --> PTW --> FRESH --> SFT --> SFTCK --> TEST
    SFTCK --> MIR --> MIRCK --> TEST
    SFTCK --> RES --> REST --> SFT

    NOTE["Use --pretrained for a first SFT run;<br/>use --resume for continuation;<br/>never specify both together"]
    NOTE -.-> FIRST
    NOTE -.-> RES

    classDef checkpoint fill:#e6f8ec,stroke:#4f9c70,color:#255d3e
    classDef warning fill:#fff2dd,stroke:#bf8b43,color:#794a18
    class PTCK,SFTCK,MIRCK checkpoint
    class NOTE warning
